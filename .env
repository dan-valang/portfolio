# Portfolio Environment Variables - Local Development

# Application
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:4321

# LinkedIn OAuth (for profile sync) - Add your credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4321/api/auth/linkedin/callback

# Sentry Error Tracking - Add your credentials
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Feature Flags
ENABLE_LINKEDIN_SYNC=false
ENABLE_ERROR_TRACKING=false

# Analytics (optional)
PUBLIC_ANALYTICS_ID=

# Email (for contact form - optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=