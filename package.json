{
  "name": "portfolio-root",
  "version": "1.0.0",
  "description": "Modern portfolio monorepo with Astro and TanStack Start",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run -w astro-site dev & pnpm run -w blog dev",
    "build": "pnpm run -w astro-site build && pnpm run -w blog build",
    "lint": "echo \"run linter later\""
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vitest": "^4.0.7"
  },
  "pnpm": {
    "overrides": {
      "magicast": "0.3.5"
    }
  }
}
